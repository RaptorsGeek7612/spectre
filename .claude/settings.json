{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(~/.spectre/assistant/.env)",
      "Read(~/.spectre/assistant/browser-token)",
      "Read(~/.spectre/webui/**)",
      "Bash(uv sync)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(rm -rf *)"
    ]
  }
}
