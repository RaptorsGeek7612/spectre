SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=your_wallet_private_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# --- Spectre (Anthropic) ---
# Copiez ce fichier en .env (ignoré par git) et renseignez votre clé.
# Ne commitez jamais une vraie clé.
ANTHROPIC_API_KEY=sk-ant-...
# Uniquement pour une clé liée à un utilisateur (sk-ant-usr...) : ID du workspace à utiliser
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Client HTTP : délai d'attente (secondes), nouvelles tentatives, repli en cas de refus (0 = désactivé)
# SPECTRE_TIMEOUT=600
# SPECTRE_MAX_RETRIES=4
# SPECTRE_FALLBACKS=1

# Tours de révision Warden -> Scribe quand Warden rejette le texte (0 à 5, 0 = chaîne linéaire)
# SPECTRE_MAX_REVISIONS=1

# Interface web (python -m spectre.web) : mot de passe obligatoire pour --host 0.0.0.0
# SPECTRE_WEBUI_PASSWORD=
# SPECTRE_WEBUI_STATE_DIR=

# Surcharges facultatives par agent (SCOUT, SCRIBE, WARDEN)
# Modèle
# SPECTRE_SCOUT_MODEL=claude-haiku-4-5
# SPECTRE_SCRIBE_MODEL=claude-sonnet-5-5
# SPECTRE_WARDEN_MODEL=claude-opus-5-5

# Limite de tokens en sortie
# SPECTRE_SCOUT_MAX_TOKENS=1024
# SPECTRE_SCRIBE_MAX_TOKENS=16000
# SPECTRE_WARDEN_MAX_TOKENS=16000

# Effort : low | medium | high | xhigh | max (Sonnet / Opus uniquement ; Haiku ne le supporte pas)
# SPECTRE_SCRIBE_EFFORT=medium
# SPECTRE_WARDEN_EFFORT=high
